#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
#include "llcast_version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "llcast.manifest"
IDI_LLCAST ICON "llcast.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION LLCAST_FILE_VERSION
PRODUCTVERSION LLCAST_FILE_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "LLCast screen sharing"
            VALUE "FileVersion", LLCAST_SOURCE_VERSION
            VALUE "InternalName", "LLCast"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "LLCast.exe"
            VALUE "ProductName", "LLCast"
            VALUE "ProductVersion", LLCAST_SOURCE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_CHOOSER DIALOGEX 0, 0, 310, 208
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "LLCast"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CTEXT "How do you want to use this PC?", IDC_INTRO, 16, 14, 278, 18
    CONTROL "Send", IDC_SEND, "Button", BS_OWNERDRAW | WS_TABSTOP, 20, 40, 128, 82
    CONTROL "Receive", IDC_RECEIVE, "Button", BS_OWNERDRAW | WS_TABSTOP, 162, 40, 128, 82
    CTEXT "Show this PC's screen on another device.", IDC_STATIC, 20, 128, 128, 24
    CTEXT "Show another device on this screen.", IDC_STATIC, 162, 128, 128, 24
    LTEXT "Receive mode:", IDC_STATIC, 20, 166, 66, 10
    COMBOBOX IDC_RECEIVE_MODE, 87, 163, 127, 55, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Lowest latency may show tearing.", IDC_HINT, 20, 185, 210, 12
    PUSHBUTTON "Close", IDCANCEL, 240, 184, 50, 14
END

IDD_RECEIVE DIALOGEX 0, 0, 640, 360
STYLE DS_SETFONT | WS_POPUP | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "LLCast — Receive"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL "", IDC_RX_VIDEO, "LLCastVideo", WS_CHILD | WS_VISIBLE, 0, 0, 640, 360
    CONTROL "", IDC_RX_BACKGROUND, "Static", SS_OWNERDRAW, 0, 0, 640, 360
    CTEXT "Checking hardware video decoding…", IDC_RX_TEXT, 20, 100, 600, 200, SS_NOPREFIX
    PUSHBUTTON "HEVC help…", IDC_RX_HEVC, 230, 320, 180, 20
    PUSHBUTTON "Back", IDCANCEL, 550, 12, 70, 20
END

IDD_MAIN DIALOGEX 0, 0, 262, 252
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "LLCast — Send"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "Streams this PC's main display to an LLCast receiver.",
          IDC_INTRO, 10, 9, 242, 18
    LTEXT "&Receiver:", IDC_STATIC, 10, 35, 52, 8
    EDITTEXT IDC_HOST, 64, 33, 188, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Type it as the receiver shows it, with its port if it shows one.",
          IDC_HINT, 64, 50, 188, 8
    // User decision: profile, encoder, codec, then the bandwidth budget.
    LTEXT "&Profile:", IDC_STATIC, 10, 66, 50, 8
    COMBOBOX IDC_PROFILE, 64, 64, 188, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_WIDTH, 64, 81, 30, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "×", IDC_STATIC, 97, 83, 6, 8
    EDITTEXT IDC_HEIGHT, 105, 81, 30, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "at", IDC_STATIC, 139, 83, 9, 8
    EDITTEXT IDC_FPS, 150, 81, 22, 13, ES_NUMBER | WS_TABSTOP
    LTEXT "fps", IDC_STATIC, 175, 83, 14, 8
    LTEXT "&Encoder:", IDC_STATIC, 10, 102, 50, 8
    COMBOBOX IDC_ENCODER, 64, 100, 188, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Codec:", IDC_STATIC, 10, 120, 50, 8
    COMBOBOX IDC_CODEC, 64, 118, 118, 72, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "&Bandwidth:", IDC_STATIC, 10, 138, 52, 8
    AUTOCHECKBOX "&Auto", IDC_BUDGET_AUTO, 64, 137, 32, 10, WS_TABSTOP
    EDITTEXT IDC_BUDGET, 98, 136, 36, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Mbps", IDC_STATIC, 138, 138, 24, 8
    AUTOCHECKBOX "&Don't scale: send the top-left part at full size", IDC_NOSCALE,
          64, 156, 188, 10, WS_TABSTOP
    CONTROL "", IDC_STATIC, "Static", SS_ETCHEDHORZ, 10, 172, 242, 1
    // Six lines: streaming and reception (each may wrap), budget advice, a capture pause.
    LTEXT "Ready.", IDC_STATUS, 10, 180, 242, 52, SS_NOPREFIX
    PUSHBUTTON "Co&py", IDC_COPY, 10, 232, 50, 14
    DEFPUSHBUTTON "&Start", IDC_START, 148, 232, 50, 14
    PUSHBUTTON "Back", IDCANCEL, 202, 232, 50, 14
END
